{
  "name": "jarvis-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS persistent control plane — tasks, approvals, audit. Owns business state independently of any AI session.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "api": "node --experimental-sqlite --import tsx src/api/server.ts",
    "worker": "node --experimental-sqlite --import tsx src/worker/worker.ts",
    "test": "node --experimental-sqlite --import tsx --test \"tests/**/*.test.ts\"",
    "migrate": "node --experimental-sqlite --import tsx src/db/migrate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
